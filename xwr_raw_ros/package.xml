<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- Modified by Chan Sheng Bin, 2026: ROS 2 package description, licence and dependencies. See NOTICE. -->
<package format="3">
  <name>xwr_raw_ros</name>
  <version>0.2.0</version>
  <description>Raw ADC capture from TI mmWave radars through the DCA1000EVM, for ROS 2. A ROS 2 port of ConnectedSystemsLab/xwr_raw_ros, set up for the IWR6843AOPEVM.</description>
  <maintainer email="ShengBin-101@users.noreply.github.com">Chan Sheng Bin</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ShengBin-101/xwr_raw_ros</url>
  <url type="website">https://github.com/ConnectedSystemsLab/xwr_raw_ros</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-numba</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
